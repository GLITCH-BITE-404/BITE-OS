#!/usr/bin/env bash
# ━━━ BITE-OS — Hyprland session launcher (live + installed) ━━━
# SDDM (autologin on the live ISO, or a picked session) calls THIS.
#
# LIVE ISO: boots the FULL BITE-OS rice — the same ~/.config payload that
# /etc/skel ships to installed systems. bite-os-live-setup force-rebuilds
# /home/bite from /etc/skel before sddm starts (so the boot overlay can never
# hand us an empty home) and appends a live-only exec-once that opens the
# Calamares installer ON TOP of the riced desktop. The live demo IS the
# product — show the dots, not a kiosk.
#
# Safety nets, in order:
#   1. VM without real GPU accel → force software rendering so Hyprland AND
#      quickshell/caelestia come up instead of black-screening (this was the
#      original reason the live session got locked down to a kiosk).
#   2. Rice config missing (skel copy failed?) → fall back to the minimal
#      read-only live config, which still auto-launches the installer.
#   3. The "Install BITE-OS" cage kiosk session remains selectable in SDDM if
#      Hyprland itself won't start on some cursed GPU.
set -u
LOG=/tmp/bite-os-session.log
LIVE_CFG=/usr/share/bite-os/live/hyprland.conf
RICE_CFG="$HOME/.config/hypr/hyprland.conf"

is_live() { [ -d /run/archiso ] || grep -q archisobasedir /proc/cmdline 2>/dev/null; }

{
    echo "════════ $(date -Is) bite-os-hyprland-session ════════"
    echo "uid=$(id -u) home=$HOME live=$(is_live && echo yes || echo no) rice_cfg=$([ -s "$RICE_CFG" ] && echo present || echo MISSING)"
} >> "$LOG" 2>&1

if is_live; then
    # VMs (VirtualBox/QEMU/VMware without 3D accel): software-render everything.
    # Real hardware is untouched — this only fires when systemd-detect-virt says
    # we're inside a VM, and only on the live ISO.
    if systemd-detect-virt -q 2>/dev/null; then
        export LIBGL_ALWAYS_SOFTWARE=1
        export WLR_NO_HARDWARE_CURSORS=1
        export WLR_RENDERER_ALLOW_SOFTWARE=1
        echo "VM detected → software rendering forced (LIBGL_ALWAYS_SOFTWARE=1)" >> "$LOG"
    fi

    if [ -s "$RICE_CFG" ]; then
        echo "stage: LIVE → full BITE-OS rice ($RICE_CFG)" >> "$LOG" 2>&1
        exec /usr/bin/Hyprland "$@"
    fi

    if [ -f "$LIVE_CFG" ]; then
        {
            echo "stage: LIVE FALLBACK → rice config MISSING, using read-only $LIVE_CFG"
            # The minimal session has no bar/shell; keep the rice's self-repair
            # service from spawning caelestia into it half-broken.
            systemctl --user mask bite-os-healthcheck.service >/dev/null 2>&1 || true
            pkill -u "$(id -u)" -x quickshell  >/dev/null 2>&1 || true
            pkill -u "$(id -u)" -f caelestia   >/dev/null 2>&1 || true
        } >> "$LOG" 2>&1
        exec /usr/bin/Hyprland -c "$LIVE_CFG" "$@"
    fi
fi

# Installed system (or live fallbacks unavailable): behave like a normal OS —
# Hyprland reads the user's own ~/.config/hypr (the full rice from /etc/skel).
echo "stage: not live (or no live cfg) → normal Hyprland" >> "$LOG" 2>&1
exec /usr/bin/Hyprland "$@"
