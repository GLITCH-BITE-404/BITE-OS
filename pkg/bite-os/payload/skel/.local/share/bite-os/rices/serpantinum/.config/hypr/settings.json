{
  "uiScale": 1,
  "openGuideAtStartup": true,
  "topbarHelpIcon": true,
  "workspaceCount": 8,
  "wallpaperDir": "",
  "language": "us,ru,il",
  "kbOptions": "grp:alt_shift_toggle",
  "monitors": [],
  "keybinds": [
