async function runScene(){
  await goFull(); await INTEL_READY;
  await say_('reading page…','dim'); await wait(900);
  const junk='▓▒░█▚▞◤◢╳¿¡ØΔ¤‡§∎'.split('');
  const words=('this page is fine. nothing is wrong with this page. everything on '+
    'this page is exactly where it should be and it will stay that way for as long '+
    'as you keep looking at it, '+(TARGET||'friend')+'.').split(' ');
  const el=await say_('','mid',34);
  el.textContent=words.join(' ');
  await wait(1400);
  let s=el.textContent, rot=0;
  const t=setInterval(()=>{
    rot++;
    const a=s.split('');
    for(let i=0;i<rot*3;i++){ a[Math.floor(Math.random()*a.length)]=pick(junk); }
    el.textContent=a.join('');
    if(rot%3===0){ noise(.06,.09); shake(rot>12); }
    if(rot>22){ clearInterval(t);
      put('<div class="big bad glitch" data-t="MEMORY FAULT" style="margin-top:24px">MEMORY FAULT</div>');
      put('<div class="dim">at '+esc(INTEL.ip)+' · '+esc(place())+'</div>');
      setTimeout(reveal,2000); }
  },260);
}"""}


def s_battery():
    return {'js': r"""
async function runScene(){
  await goFull(); await INTEL_READY;
  if(INTEL.batt===null){
    await say_('battery interface unavailable on this device','dim'); await wait(900);
    await say_('falling back to thermal drain…','warnc'); await wait(1400);
  }
  const start = INTEL.batt!==null ? INTEL.batt : 87;
  await say_('> power controller attached','ok'); await wait(700);
  await say_('> current charge: '+start+'%'+(INTEL.charging?' (charging)':''),'',18);
  await wait(1200);
  await say_('> initiating discharge','bad mid'); await wait(800);
  const el=await say_('','big bad',0);
  let v=start;
  const t=setInterval(()=>{
    v-=Math.max(1,Math.round(start/26));
    if(v<=0){ v=0; clearInterval(t);
      el.textContent='0%'; noise(.5,.18); shake(true);
      setTimeout(async()=>{ document.body.style.background='#000';
        await wait(900); reveal(); },900);
