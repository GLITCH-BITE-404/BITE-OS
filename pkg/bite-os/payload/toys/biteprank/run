SHARED_JS = r"""
const BRAND=__BRAND__, TAGLINE=__TAGLINE__, TARGET=__TARGET__, GOTCHA=__GOTCHA__;
const PACE=__PACE__, SOUNDON=__SOUND__, REPORT=__REPORT__;

/* The only thing this page ever sends anywhere: a one-word note to the server
   that served it — which is the sender's own terminal — so they can watch the
   prank land in real time. Same origin, no body, no identifiers; the server
   already saw the request that fetched the page. On GitHub Pages there is
   nothing listening and it fails silently. The reveal says this happened. */
function hit(stage){
  if(!REPORT) return;
  try{ navigator.sendBeacon('hit?s='+encodeURIComponent(stage)); }
  catch(e){ try{ fetch('hit?s='+stage,{method:'POST',keepalive:true}); }catch(e2){} }
}
const $=s=>document.querySelector(s), stage=()=>$('#stage'), wrap=()=>$('#stage .wrap');
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const rnd=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const esc=s=>String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));

/* ── sound: nothing is downloaded, every noise is synthesised on the spot ── */
let AC=null;
function ac(){ if(!SOUNDON) return null;
  if(!AC){ try{ AC=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return null; } }
  if(AC.state==='suspended') AC.resume();
  return AC; }
function tone(f,dur,type,vol){ const a=ac(); if(!a) return;
  const o=a.createOscillator(), g=a.createGain();
  o.type=type||'square'; o.frequency.value=f;
  g.gain.setValueAtTime(vol||.06,a.currentTime);
  g.gain.exponentialRampToValueAtTime(.0001,a.currentTime+dur);
  o.connect(g).connect(a.destination); o.start(); o.stop(a.currentTime+dur); }
function noise(dur,vol){ const a=ac(); if(!a) return;
  const n=a.sampleRate*dur, buf=a.createBuffer(1,n,a.sampleRate), d=buf.getChannelData(0);
  for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*(1-i/n);
  const s=a.createBufferSource(), g=a.createGain();
  s.buffer=buf; g.gain.value=vol||.14;
  s.connect(g).connect(a.destination); s.start(); }
function beeps(n,f){ for(let i=0;i<(n||3);i++) setTimeout(()=>tone(f||880,.09),i*150); }
function click(){ tone(1400+Math.random()*600,.012,'square',.02); }

/* ── the intel: every field below is real, which is why the fake ones work ── */
const INTEL={ip:'…',city:'',region:'',country:'',org:'',os:'',browser:'',mobile:false,
  screen:'',lang:'',cores:'',mem:'',tz:'',batt:null,charging:null,net:'',now:''};
const INTEL_READY=(async()=>{
  const ua=navigator.userAgent;
  INTEL.os = /Windows NT 10/.test(ua)?'Windows 10/11' : /Windows/.test(ua)?'Windows'
    : /Android/.test(ua)?'Android' : /iPhone|iPad/.test(ua)?'iOS'
    : /Mac OS X/.test(ua)?'macOS' : /CrOS/.test(ua)?'ChromeOS'
    : /Linux/.test(ua)?'Linux' : 'unknown';
  INTEL.browser = /Edg\//.test(ua)?'Edge' : /OPR\//.test(ua)?'Opera'
    : /Firefox\//.test(ua)?'Firefox' : /Chrome\//.test(ua)?'Chrome'
    : /Safari\//.test(ua)?'Safari' : 'unknown';
  INTEL.mobile  = /Android|iPhone|iPad|Mobile/.test(ua);
  INTEL.screen  = screen.width+'×'+screen.height+' @'+(window.devicePixelRatio||1)+'x';
  INTEL.lang    = navigator.language||'--';
  INTEL.cores   = navigator.hardwareConcurrency||'?';
  INTEL.mem     = navigator.deviceMemory ? navigator.deviceMemory+' GB' : 'undisclosed';
  try{ INTEL.tz = Intl.DateTimeFormat().resolvedOptions().timeZone; }catch(e){ INTEL.tz='--'; }
  INTEL.now = new Date().toLocaleString();
  try{ const c=navigator.connection; if(c&&c.effectiveType) INTEL.net=c.effectiveType.toUpperCase(); }catch(e){}
  try{ if(navigator.getBattery){ const b=await navigator.getBattery();
        INTEL.batt=Math.round(b.level*100); INTEL.charging=b.charging; } }catch(e){}
  /* one lookup, two providers, no key, nothing stored anywhere */
  try{
    const r=await fetch('https://ipwho.is/',{referrerPolicy:'no-referrer'});
    const j=await r.json();
    if(j&&j.success!==false){ INTEL.ip=j.ip; INTEL.city=j.city||''; INTEL.region=j.region||'';
      INTEL.country=j.country||''; INTEL.org=(j.connection&&j.connection.isp)||''; }
    else throw 0;
  }catch(e){
    try{ const r=await fetch('https://ipapi.co/json/',{referrerPolicy:'no-referrer'});
      const j=await r.json();
      INTEL.ip=j.ip||'unavailable'; INTEL.city=j.city||''; INTEL.region=j.region||'';
      INTEL.country=j.country_name||''; INTEL.org=j.org||'';
    }catch(e2){ INTEL.ip='unavailable'; }
  }
  return INTEL;
})();
const place=()=>[INTEL.city,INTEL.region,INTEL.country].filter(Boolean).join(', ')||'location withheld';
const device=()=>(INTEL.os||'?')+' · '+(INTEL.browser||'?')+(INTEL.mobile?' · mobile':'');

/* ── output helpers ── */
/* Everything lands inside .wrap so lines keep a readable measure instead of
   stretching the full width of a 4K monitor; #stage is what scrolls. */
function put(h){ wrap().insertAdjacentHTML('beforeend',h);
  stage().scrollTop=stage().scrollHeight; }
async function say_(text,cls,speed){
  const el=document.createElement('div');
  if(cls) el.className=cls; wrap().appendChild(el);
  const sp=speed||PACE;
  for(const ch of text){ el.textContent+=ch; if(ch.trim()) click();
    stage().scrollTop=stage().scrollHeight; await wait(sp); }
  return el;
}
async function bar(label,ms){
  const el=document.createElement('div');
  el.innerHTML='<div class="dim">'+esc(label)+'</div><div class="bar"><i></i></div>';
  wrap().appendChild(el); const fill=el.querySelector('i');
  const t0=performance.now();
  return new Promise(r=>{ (function step(){
    const p=Math.min(1,(performance.now()-t0)/ms);
    fill.style.width=(p*100).toFixed(1)+'%';
    if(p<1) requestAnimationFrame(step); else r(el);
  })(); });
}
function shake(on){ document.body.classList.toggle('shake',on!==false); }
/* Fire-and-forget on purpose. Without a user gesture this rejects, and in some
   embedded contexts the promise never settles at all — awaiting it would stall
   the scene on its first line, so nothing here ever waits for the answer. */
function goFull(){
  try{ const p=document.documentElement.requestFullscreen();
       if(p&&p.catch) p.catch(()=>{}); }catch(e){}
}

/* ── the punchline: every scene, no exceptions, ends here ── */
let DONE=false;
async function reveal(){
  if(DONE) return; DONE=true;
  shake(false);
  try{ if(document.fullscreenElement) await document.exitFullscreen(); }catch(e){}
  document.querySelectorAll('.ephemeral').forEach(n=>n.remove());
  const who = TARGET ? esc(TARGET)+', ' : '';
  $('#reveal').innerHTML =
    '<div class="card">'+
      '<div class="glitch big" data-t="GOTCHA">GOTCHA</div>'+
      '<p>'+who+'nothing happened.</p>'+
      '<p>No files were touched, nothing was downloaded, nothing was installed, '+
      'and nothing about you was stored anywhere. It was one web page in one '+
      'tab, and it just got closed.</p>'+
      (REPORT ? '<p>The one thing that did happen: whoever sent you this got a '+
                'line in their terminal saying you opened it. That is the whole '+
                'hack.</p>' : '')+
      (GOTCHA ? '<p style="color:#e8ffe8">'+esc(GOTCHA)+'</p>' : '')+
      '<div class="sig">'+esc(BRAND)+' biteprank · '+esc(TAGLINE)+'</div>'+
      '<button id="bail">😂 alright, you got me</button>'+
    '</div>';
  $('#reveal').style.display='flex';
  hit('reveal');
  $('#bail').onclick=()=>{ try{window.close();}catch(e){} location.replace('about:blank'); };
  beeps(3,520);
}
"""

BOOT_JS = r"""
document.addEventListener('keydown',e=>{ if(e.key==='Escape'||e.key==='Esc') reveal(); });
let STARTED=false;

/* A real video does not cut to something else the instant you press play — it
   buffers first. Going straight from the card to the scene is the single
   biggest tell, so the player spends a second and a half looking like it is
   loading, with a timecode that actually ticks. */
function buffer(b){
  return new Promise(done=>{
    const card=b.querySelector('.bcard');
    if(!card){ done(); return; }
    b.style.background='#000';
    card.style.background='#000'; card.style.boxShadow='none';
    card.innerHTML='<div class="bmedia"><div class="bspin"></div>'+
                   '<div class="bdur" id="btc">0:00</div></div>';
    const tc=card.querySelector('#btc'); let t=0;
    const iv=setInterval(()=>{ t++; tc.textContent='0:'+String(t).padStart(2,'0'); },430);
    setTimeout(()=>{ clearInterval(iv); done(); },1650);
  });
}

async function launch(){
  if(STARTED) return; STARTED=true;
  /* Called from inside a real click handler, which is the only moment a
     browser will grant fullscreen and let a sound play. Order matters. */
  ac(); goFull(); hit('open');
  const b=$('#bait');
  if(b && b.dataset.load) await buffer(b);
  if(b) b.remove();
  const h=document.querySelector('.hint'); if(h) h.style.display='block';
  runScene().catch(e=>{ console.error(e); reveal(); });
}
window.addEventListener('load',()=>{
  const b=$('#bait');
  if(b){
    /* Wait for them. The click is the whole point — it is consent to be
       startled, and it is what unlocks fullscreen and audio. */
    b.addEventListener('click',launch,{once:true});
    b.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' ') launch(); });
    hit('bait');
  } else {
    /* No bait: start immediately and upgrade on whatever they touch first. */
    const go=()=>{ document.removeEventListener('pointerdown',go);
                   document.removeEventListener('keydown',go);
                   ac(); if(!DONE) goFull(); };
    document.addEventListener('pointerdown',go);
    document.addEventListener('keydown',go);
    launch();
  }
});
"""

# ───────────────────────────────────────────────────────────── the bait ────
#
# The honest problem with sending someone a prank link: nobody clicks a bare
# URL, and nobody opens a stray .html at all. So the page opens as something
# ordinary — a message with a video in it, a photo waiting to be revealed, a
# shared folder — and the scene erupts out of whatever they press.
#
# That framing also solves a real technical problem. Browsers refuse fullscreen
# and refuse to make a sound until the visitor has deliberately touched the
# page, so without a bait half the effect fired into a muted, windowed tab. The
# bait guarantees exactly one deliberate click, which is all either needs.
#
# There is no bait that asks for a password, a login, or a payment, and there
# never will be — that stops being a prank and starts being phishing. These
# imitate no real service: no logos, no brand names, no lookalike domains.

