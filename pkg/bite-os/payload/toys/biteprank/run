def s_bsod():
    """Windows 10/11 stop screen, laid out the way the real one is.

    The details are the whole point: Segoe UI rather than a monospace font, the
    thin sad face at the top left of an 11% margin, the percentage on its own
    line, and — the part everyone remembers — the QR block beside the support
    text. Get those right and nobody reads it as a web page.
    """
    return {'real': True, 'css': """
body{background:#0078D7;color:#fff;cursor:none;
  font:400 16px/1.42 "Segoe UI Variable Text","Segoe UI",Selawik,"Noto Sans",
       system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
#stage{padding:0;display:flex;align-items:center;overflow:hidden}
.wrap{max-width:none;margin:0;width:100%;padding:0 8vw 0 11vw}
.sad{font-size:clamp(64px,9.5vw,132px);line-height:1;font-weight:275;margin-bottom:22px}
.msg{font-size:clamp(16px,1.75vw,23px);line-height:1.4;max-width:30em;margin-bottom:24px}
.pct{font-size:clamp(16px,1.75vw,23px);margin-bottom:30px}
.qrrow{display:flex;gap:20px;align-items:flex-start;max-width:40em}
.qrbox{background:#fff;padding:6px;flex:none;line-height:0}
.sup{font-size:13px;line-height:1.5}
.stop{margin-top:22px;font-size:13px;line-height:1.55}
""", 'js': r"""
/* A drawn stand-in for the stop-screen QR: three finder squares and a stable
   scatter. It does not encode anything — it is not meant to be scanned, it is
   meant to be recognised from across a room. */
function qrSVG(n,px){
  n=n||25; px=px||5;
  const m=Array.from({length:n},()=>new Array(n).fill(0));
  const finder=(ox,oy)=>{ for(let y=0;y<7;y++) for(let x=0;x<7;x++){
      const edge=(x===0||x===6||y===0||y===6), core=(x>=2&&x<=4&&y>=2&&y<=4);
      m[oy+y][ox+x]=(edge||core)?1:0; } };
  let seed=987654321; const rnd=()=>{ seed=(seed*1103515245+12345)&0x7fffffff; return seed/0x7fffffff; };
  for(let y=0;y<n;y++) for(let x=0;x<n;x++){
    const inFinder=(x<8&&y<8)||(x>=n-8&&y<8)||(x<8&&y>=n-8);
    if(!inFinder) m[y][x]=rnd()<.46?1:0;
  }
  for(let i=8;i<n-8;i++){ m[6][i]=i%2?0:1; m[i][6]=i%2?0:1; }
  finder(0,0); finder(n-7,0); finder(0,n-7);
  let r='';
  for(let y=0;y<n;y++) for(let x=0;x<n;x++) if(m[y][x])
    r+='<rect x="'+x+'" y="'+y+'" width="1" height="1"/>';
  return '<svg width="'+n*px+'" height="'+n*px+'" viewBox="0 0 '+n+' '+n+'" fill="#000">'+r+'</svg>';
}

async function runScene(){
  await INTEL_READY;
  const codes=['CRITICAL_PROCESS_DIED','KERNEL_SECURITY_CHECK_FAILURE',
               'SYSTEM_SERVICE_EXCEPTION','PAGE_FAULT_IN_NONPAGED_AREA'];
  const code=pick(codes);
  const mod=(INTEL.browser||'win32k').toLowerCase()+'.sys';
  wrap().innerHTML =
    '<div class="sad">:(</div>'+
    '<div class="msg">Your PC ran into a problem and needs to restart. '+
      "We're just collecting some error info, and then we'll restart for you.</div>"+
    '<div class="pct" id="pc">0% complete</div>'+
    '<div class="qrrow"><div class="qrbox">'+qrSVG(25,5)+'</div>'+
      '<div class="sup">For more information about this issue and possible fixes, '+
      'visit https://www.windows.com/stopcode<br><br>'+
      'If you call a support person, give them this info:</div></div>'+
    '<div class="stop">Stop code: '+esc(code)+'<br>What failed: '+esc(mod)+'</div>';
  tone(180,.45,'sine',.05);
  const el=$('#pc');
  /* The real one does not climb smoothly — it sticks, then jumps. */
  let v=0;
  while(v<100){
    v=Math.min(100, v+(Math.random()<.25?0:Math.ceil(rnd(1,7))));
    el.textContent=v+'% complete';
    await wait(v>90?rnd(400,900):rnd(90,420));
  }
  await wait(2400);
  await reveal();
}"""}


def s_panic():
    """A bare Linux console. No filter, no colour, no styling at all.

    A real panic is grey-on-black in whatever the console font is, with tight
    line spacing and a cursor that stops blinking when the kernel dies. Anything
    added to that — a glow, a scanline, a green tint — is exactly what makes it
    read as a screensaver instead of a dead machine.
    """
    return {'real': True, 'css': """
body{background:#000;color:#b2b2b2;cursor:none;
  font:400 15px/1.15 "DejaVu Sans Mono","Liberation Mono",Consolas,monospace}
#stage{padding:8px 10px;overflow:hidden}
.wrap{max-width:none;margin:0;white-space:pre-wrap;word-break:break-all}
.cur{display:inline-block;width:8px;height:15px;background:#b2b2b2;
  vertical-align:-2px;animation:cbl 1.05s steps(2) infinite}
@keyframes cbl{50%{opacity:0}}
""", 'js': r"""
const NL = String.fromCharCode(10);
async function runScene(){
  await INTEL_READY;
  const w=wrap();
  let clk=0.0;
  const stamp=()=>{ clk+=Math.random()*0.04; return '['+clk.toFixed(6).padStart(12,' ')+'] '; };
  const emit=(str)=>{ w.insertAdjacentText('beforeend',str+NL); };
  const hex=(n)=>{ let s=''; for(let i=0;i<n;i++) s+='0123456789abcdef'[Math.floor(Math.random()*16)]; return s; };
  const lines=[
    stamp()+'Kernel panic - not syncing: Attempted to kill init! exitcode=0x00000100',
    stamp()+'CPU: '+(INTEL.cores||4)+' PID: 1 Comm: systemd Tainted: G     U      6.9.3-1',
    stamp()+'Hardware name: '+(INTEL.os||'Unknown')+'/'+(INTEL.browser||'Unknown')+', BIOS 2.14 05/22/2024',
    stamp()+'Call Trace:',
    stamp()+' <TASK>',
    stamp()+' dump_stack_lvl+0x48/0x70',
    stamp()+' panic+0x35c/0x390',
    stamp()+' do_exit.cold+0x1b/0x1b',
    stamp()+' do_group_exit+0x31/0xa0',
    stamp()+' __x64_sys_exit_group+0x18/0x20',
    stamp()+' do_syscall_64+0x5f/0x170',
    stamp()+' entry_SYSCALL_64_after_hwframe+0x76/0x7e',
    stamp()+'RIP: 0033:0x7f'+hex(10),
    stamp()+'RSP: 002b:00007ffd'+hex(8)+' EFLAGS: 00000246',
    stamp()+'RAX: ffffffffffffffda RBX: 00000000000000e7 RCX: 00007f'+hex(10),
    stamp()+' </TASK>',
    stamp()+'Kernel Offset: 0x'+hex(7)+' from 0xffffffff81000000',
    stamp()+'---[ end Kernel panic - not syncing: Attempted to kill init! ]---',
  ];
  for(const l of lines){ emit(l); tone(140,.012,'square',.012); await wait(rnd(40,150)); }
  const c=document.createElement('span'); c.className='cur'; w.appendChild(c);
  await wait(4200);
  /* A panicked kernel stops updating the screen — including the cursor. */
  c.style.animation='none';
  await wait(2600);
  await reveal();
}"""}


