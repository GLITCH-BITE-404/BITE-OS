# ─────────────────────────────────────────────────────────── settings ────

def env(k, d=''):
    return os.environ.get('TOY_' + k, d)

BRAND    = env('BRAND', 'BITE-OS')
TAGLINE  = env('TAGLINE', 'you have been bitten')
OUTDIR   = Path(os.path.expanduser(env('OUTDIR', '~/biteprank'))).expanduser()
DEF_HOST = env('HOST', 'tunnel')
DEF_NAME = env('TARGET', '')
GH_REPO  = env('GHREPO', '')
PORT     = int(env('PORT', '8404') or 8404)
DEF_BAIT = env('BAIT', 'video')
PACE     = env('PACE', 'normal')
SOUND    = env('SOUND', 'on') == 'on'
CURSOR   = env('CURSOR', 'on') == 'on'
COPYLINK = env('COPYLINK', 'on') == 'on'
QR       = env('QR', 'on') == 'on'

CACHE = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'bite-os'
LOG   = CACHE / 'biteprank.log'

PACE_MS = {'slow': 46, 'normal': 26, 'fast': 12}.get(PACE, 26)

# ────────────────────────────────────────────────────────────── colour ────

class C:
    r = '\033[0m'; b = '\033[1m'; d = '\033[2m'
    g = '\033[38;5;46m'; c = '\033[38;5;51m'; m = '\033[38;5;201m'
    y = '\033[38;5;226m'; e = '\033[38;5;196m'; w = '\033[38;5;250m'

if not sys.stdout.isatty() or os.environ.get('NO_COLOR'):
    for _k in dir(C):
        if not _k.startswith('_'):
            setattr(C, _k, '')

def say(msg=''):
    # Flushed on purpose: the live feed is written from server threads while the
    # main thread sleeps, and any redirection at all (a log file, a pipe, tmux
    # capture) turns stdout block-buffered — so the play-by-play would arrive
    # in one lump at Ctrl-C, or never.
    print(msg, flush=True)

def ok(msg):
    say(f'{C.g}  ✔{C.r} {msg}')

def warn(msg):
    say(f'{C.y}  !{C.r} {msg}')

def die(msg, code=1):
    say(f'{C.e}  ✘{C.r} {msg}')
    sys.exit(code)

# ───────────────────────────────────────────────────── the page shell ────

