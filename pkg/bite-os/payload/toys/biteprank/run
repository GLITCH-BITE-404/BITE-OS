  },230);
}"""}


def s_update():
    """The forced-update screen, down to the spinner.

    Windows does not use a spinning ring here, it uses five dots chasing each
    other around a circle with an easing that makes them bunch up and stretch
    out again. That spinner is the most recognisable thing on the screen, so it
    is built properly rather than faked with a border-radius trick.
    """
    return {'real': True, 'css': """
body{background:#0078D7;color:#fff;cursor:none;
  font:400 16px/1.5 "Segoe UI Variable Text","Segoe UI",Selawik,"Noto Sans",
       system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
#stage{padding:0;display:flex;align-items:center;justify-content:center;text-align:center}
.wrap{max-width:none;width:100%}
.wspin{position:relative;width:78px;height:78px;margin:0 auto 46px}
.wspin i{position:absolute;inset:0;animation:wsp 1.85s cubic-bezier(.62,.03,.4,.97) infinite}
.wspin i::after{content:"";position:absolute;top:0;left:50%;width:7px;height:7px;
  margin-left:-3.5px;border-radius:50%;background:#fff}
/* Negative, so the dots are already strung out around the ring on the very
   first frame. Positive delays leave all five stacked on top of each other for
   the first half second, which is the one moment anybody is looking. */
.wspin i:nth-child(2){animation-delay:-.13s}
.wspin i:nth-child(3){animation-delay:-.26s}
.wspin i:nth-child(4){animation-delay:-.39s}
.wspin i:nth-child(5){animation-delay:-.52s}
@keyframes wsp{to{transform:rotate(360deg)}}
.head{font-size:clamp(21px,2.6vw,32px);font-weight:300;margin-bottom:16px}
.sub{font-size:clamp(14px,1.5vw,18px);font-weight:300;opacity:.95}
.sub2{font-size:clamp(13px,1.35vw,16px);font-weight:300;opacity:.85;margin-top:8px}
""", 'js': r"""
const DONT = "Don" + String.fromCharCode(39) + "t turn off your PC. This will take a while.";
async function runScene(){
  await INTEL_READY;
  wrap().innerHTML =
    '<div class="wspin"><i></i><i></i><i></i><i></i><i></i></div>'+
    '<div class="head" id="h">Working on updates 0%</div>'+
    '<div class="sub" id="s1"></div>'+
    '<div class="sub2" id="s2">Your PC will restart several times.</div>';
  const h=$('#h'), s1=$('#s1'), s2=$('#s2');
  s1.textContent=DONT;
  let v=0;
  while(v<32){ v+=rnd(.3,2.1); h.textContent='Working on updates '+Math.floor(v)+'%';
    await wait(rnd(140,520)); }
  s1.textContent='Getting Windows ready';
  while(v<71){ v+=rnd(.2,1.6); h.textContent='Working on updates '+Math.floor(v)+'%';
    await wait(rnd(180,700)); }
  s1.textContent=DONT;
  while(v<99){ v+=rnd(.1,.9); h.textContent='Working on updates '+Math.floor(v)+'%';
    await wait(rnd(240,900)); }
  h.textContent='Working on updates 99%';
  /* The dead stop at 99 does more work than anything that moves. */
  await wait(7000);
  s2.textContent='';
  await wait(1800);
  h.textContent='We could' + String.fromCharCode(39) + 't complete the updates';
  s1.textContent='Undoing changes';
  s2.textContent='Do not turn off your computer';
  await wait(3400);
  await reveal();
}"""}


