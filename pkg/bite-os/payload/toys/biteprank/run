             esc(INTEL.ip)+' ('+place()+').','',12);
  await wait(1000);
  await say_('Purging local trace in:','mid');
  const el=await say_('','big',0);
  for(let n=10;n>0;n--){ el.textContent=n; tone(160+n*30,.12,'square',.09); await wait(760); }
  el.textContent='0';
  noise(.7,.24); shake(true);
  document.body.style.background='#fff';
  await wait(160); document.body.style.background='#000';
  await wait(1400); await reveal();
}"""}


