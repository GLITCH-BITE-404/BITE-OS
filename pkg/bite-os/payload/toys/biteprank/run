# ────────────────────────────────────────────────────────── page build ────

def build_page(key, bait, target, gotcha, report=False):
    sc = SCENES[key]
    parts = sc['build']()
    css = (SHELL_CSS.replace('__CURSOR__', 'default' if CURSOR else 'none')
           + (BAIT_CSS if bait != 'none' else '') + parts.get('css', ''))
    shared = (SHARED_JS
              .replace('__BRAND__', json.dumps(BRAND))
              .replace('__TAGLINE__', json.dumps(TAGLINE))
              .replace('__TARGET__', json.dumps(target or ''))
              .replace('__GOTCHA__', json.dumps(gotcha or ''))
              .replace('__PACE__', str(PACE_MS))
              .replace('__SOUND__', 'true' if SOUND else 'false')
              .replace('__REPORT__', 'true' if report else 'false'))
    # The bait addresses them by name when there is one and reads naturally
    # when there isn't — "yuval, is this you??" against "is this you??".
    name_bit = (html.escape(target) + ', ') if target else ''
    bait_html = BAITS[bait]['html'].replace('__NAME__', name_bit)
    title = BAITS[bait].get('pagetitle') or sc['pagetitle'] or '​'
    # `real` scenes imitate an actual OS screen and style themselves completely,
    # so they get no CRT overlay. The flag comes from the scene builder, not the
    # registry entry — the builder is what knows how it renders.
    body_class = '' if parts.get('real') else 'crt'
    return textwrap.dedent(f"""\
        <!doctype html>
        <html lang="en"><head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
        <meta name="referrer" content="no-referrer">
        <meta name="robots" content="noindex,nofollow">
        <title>{html.escape(title)}</title>
        <style>{css}</style>
        </head><body class="{body_class}">
        <div id="stage"><div class="wrap"></div></div>
        {parts.get('html', '')}
        {bait_html}
        <div id="reveal"></div>
        <div class="hint ephemeral">press ESC to stop</div>
        <script>
        {shared}
        {parts['js']}
        {BOOT_JS}
        </script>
        </body></html>
        """)

# ──────────────────────────────────────────────────────────── delivery ────

def _lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('10.255.255.255', 1))
        return s.getsockname()[0]
    except Exception:
        return '127.0.0.1'
    finally:
        s.close()


def _prank_id(key):
    seed = f'{key}{time.time()}{random.random()}'.encode()
    return key + '-' + hashlib.sha256(seed).hexdigest()[:7]


def _clip(text):
    if not COPYLINK:
        return False
    for cmd in (['wl-copy'], ['xclip', '-selection', 'clipboard']):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                pass
    return False


def _qr(text):
    if not QR or not shutil.which('qrencode'):
        return
    try:
        out = subprocess.run(['qrencode', '-t', 'ANSIUTF8', '-m', '1', text],
                             capture_output=True, text=True, timeout=8)
        if out.returncode == 0 and out.stdout.strip():
            say()
            say(out.stdout)
    except Exception:
        pass


def _log(key, target, where, link):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        with LOG.open('a') as f:
            f.write(f'{datetime.now().isoformat(timespec="seconds")}\t{key}\t'
                    f'{target or "-"}\t{where}\t{link}\n')
    except Exception:
        pass


def _write(path, page):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(page, encoding='utf-8')
    return path


def _serve(root, port):
    handler = partial(QuietHandler, directory=str(root))
    srv = ThreadingHTTPServer(('0.0.0.0', port), handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


STAGES = {
    'bait':   (lambda: C.y, 'opened the link'),
    'open':   (lambda: C.m, 'took the bait — scene is running'),
    'reveal': (lambda: C.g, 'reached the GOTCHA'),
}


class QuietHandler(SimpleHTTPRequestHandler):
    """Serves the page and narrates what happens to it.

    The page beacons one word per stage back here, so the sender watches the
    prank land live instead of wondering whether the link even worked. Behind
    cloudflared every request looks like it came from 127.0.0.1, so the real
    address is read out of CF-Connecting-IP when it is there. Nothing is
    written to disk and nothing leaves this terminal.
    """

    def log_message(self, fmt, *args):
        pass    # the beacons say more than a request log would

    def _who(self):
        ip = (self.headers.get('CF-Connecting-IP')
              or self.headers.get('X-Forwarded-For', '').split(',')[0].strip()
              or self.address_string())
        ua = self.headers.get('User-Agent', '')
        plat = ('Windows' if 'Windows' in ua else 'Android' if 'Android' in ua
                else 'iPhone' if 'iPhone' in ua or 'iPad' in ua else 'Mac' if 'Mac OS' in ua
                else 'Linux' if 'Linux' in ua else '?')
        brow = ('Edge' if 'Edg/' in ua else 'Opera' if 'OPR/' in ua
                else 'Firefox' if 'Firefox/' in ua else 'Chrome' if 'Chrome/' in ua
                else 'Safari' if 'Safari/' in ua else '?')
        return ip, f'{brow} on {plat}'

    def _event(self, stage):
        colour, label = STAGES.get(stage, (lambda: C.c, stage))
        ip, dev = self._who()
        say(f'{colour()}  ●{C.r} {C.d}{datetime.now().strftime("%H:%M:%S")}{C.r}  '
            f'{C.b}{label}{C.r}  {C.d}· {ip} · {dev}{C.r}')

    def do_POST(self):
        if urllib.parse.urlparse(self.path).path.rstrip('/').endswith('hit'):
            try:
                n = int(self.headers.get('Content-Length') or 0)
                if n:
                    self.rfile.read(n)
            except Exception:
                pass
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            self._event((q.get('s') or ['?'])[0])
            self.send_response(204)
            self.end_headers()
            return
        self.send_error(404)

    def end_headers(self):
        self.send_header('Cache-Control', 'no-store')
        super().end_headers()


def host_file(page, key, target):
    path = _write(OUTDIR / (_prank_id(key) + '.html'), page)
    ok(f'forged  {C.c}{path}{C.r}')
    say()
    say(f'{C.d}  Send them the file itself. It is entirely self-contained —')
    say(f'  no assets, no scripts pulled in, opens straight from Downloads.{C.r}')
    _clip(str(path)) and ok('path copied to clipboard')
    return str(path)


def host_local(page, key, target):
    root = OUTDIR / '.serve'
    if root.exists():
        shutil.rmtree(root, ignore_errors=True)
    name = _prank_id(key) + '.html'
    _write(root / name, page)
    _write(root / 'index.html', page)
    try:
        _serve(root, PORT)
    except OSError as exc:
        die(f'could not bind port {PORT} — {exc}. Change port in settings.')
    link = f'http://{_lan_ip()}:{PORT}/{name}'
    ok('serving on your network')
    say()
    say(f'    {C.b}{C.c}{link}{C.r}')
    _clip(link) and ok('link copied to clipboard')
    _qr(link)
    say()
    say(f'{C.d}  Only reachable from your Wi-Fi — same house, same network.')
    say(f'  Ctrl-C stops it. Anyone opening it shows up below.{C.r}')
    say()
    return link


def host_tunnel(page, key, target):
    if not shutil.which('cloudflared'):
        die('a public link needs cloudflared, which is not installed:\n\n'
            f'      {C.c}sudo pacman -S --needed cloudflared{C.r}\n\n'
            '    Or send it another way right now — every other delivery works\n'
            '    without it:  -H local  (your Wi-Fi)   -H file  (a .html to send)')
    root = OUTDIR / '.serve'
    if root.exists():
        shutil.rmtree(root, ignore_errors=True)
    _write(root / 'index.html', page)
    try:
        _serve(root, PORT)
    except OSError as exc:
        die(f'could not bind port {PORT} — {exc}')
    say(f'{C.d}  opening tunnel…{C.r}')
    proc = subprocess.Popen(
        ['cloudflared', 'tunnel', '--url', f'http://localhost:{PORT}', '--no-autoupdate'],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    link = None
    deadline = time.time() + 45
    while time.time() < deadline:
        line = proc.stdout.readline()
        if not line:
            if proc.poll() is not None:
                break
            continue
        m = re.search(r'https://[-\w]+\.trycloudflare\.com', line)
        if m:
            link = m.group(0)
            break
    if not link:
        proc.terminate()
        die('tunnel did not come up in time — try again, or use host=github')
    ok('public link is live')
    say()
    say(f'    {C.b}{C.c}{link}{C.r}')
    _clip(link) and ok('link copied to clipboard')
    _qr(link)
    say()
    say(f'{C.d}  Works anywhere — different city, mobile data, whatever.')
    say(f'  It dies the moment you Ctrl-C, so it cannot outlive the joke.{C.r}')
    say()
    return link


def host_github(page, key, target):
    if not GH_REPO:
        die('set ghrepo in settings first, e.g. ghrepo=you/prank-site\n'
            '    the repo must exist and have GitHub Pages turned on.')
    if not shutil.which('git'):
        die('git is not installed')
    slug = GH_REPO.strip().rstrip('/')
    if slug.startswith('http') or slug.startswith('git@'):
        m = re.search(r'[:/]([\w.-]+)/([\w.-]+?)(?:\.git)?$', slug)
        if not m:
            die(f'could not read a user/repo out of {slug}')
        user, repo = m.group(1), m.group(2)
    else:
        if '/' not in slug:
            die('ghrepo should look like user/repo')
        user, repo = slug.split('/', 1)
        repo = repo.removesuffix('.git')
    work = CACHE / 'biteprank-pages'
    remote = f'git@github.com:{user}/{repo}.git'
    if not (work / '.git').exists():
        shutil.rmtree(work, ignore_errors=True)
        work.parent.mkdir(parents=True, exist_ok=True)
        say(f'{C.d}  cloning {user}/{repo}…{C.r}')
        r = subprocess.run(['git', 'clone', '--depth', '1', remote, str(work)],
                           capture_output=True, text=True)
        if r.returncode:
            die(f'clone failed — {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "?"}')
    else:
        subprocess.run(['git', '-C', str(work), 'pull', '--quiet', '--ff-only'],
                       capture_output=True, text=True)
    name = _prank_id(key) + '.html'
    _write(work / name, page)
    subprocess.run(['git', '-C', str(work), 'add', name], capture_output=True)
    subprocess.run(['git', '-C', str(work), 'commit', '-m', f'add {name}'],
                   capture_output=True, text=True)
    r = subprocess.run(['git', '-C', str(work), 'push'], capture_output=True, text=True)
    if r.returncode:
        die(f'push failed — {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "?"}')
    link = f'https://{user}.github.io/{repo}/{name}'
    ok('pushed to GitHub Pages')
    say()
    say(f'    {C.b}{C.c}{link}{C.r}')
    _clip(link) and ok('link copied to clipboard')
    _qr(link)
    say()
    say(f'{C.d}  Permanent, and it does not need this terminal to stay open.')
    say(f'  Pages can take a minute on the first push. Delete the file to kill it.{C.r}')
    return link


# Ordered best-first. `needs` is (command, pacman package) — nothing here is a
# dependency of the toy, only of one particular way of sending it, which is why
# none of it is declared in toy.meta. Gating `biteprank list` behind cloudflared
# because one delivery wants it is how a toy becomes annoying.
DELIVERY = {
    'tunnel': dict(label='a public link — works anywhere, dies when you Ctrl-C',
                   needs=[('cloudflared', 'cloudflared')], fn=host_tunnel, live=True),
    'local':  dict(label='a link that only works on your own Wi-Fi',
                   needs=[], fn=host_local, live=True),
    'github': dict(label='a permanent link that outlives this terminal',
                   needs=[('git', 'git')], fn=host_github, live=False),
    'file':   dict(label='a .html on disk — for testing it yourself, not for sending',
                   needs=[], fn=host_file, live=False),
}


def missing_for(mode):
    return [(c, pkg) for c, pkg in DELIVERY[mode]['needs'] if not shutil.which(c)]


def ready(mode):
    return not missing_for(mode)


def ensure(mode):
    """Check one delivery's tools, and offer to install them rather than dying.

    Being told "cloudflared is not installed" and dropped back at a prompt is a
    dead end when the answer is one command the toy could have run. So it asks,
    runs pacman itself, and re-checks. Saying no is not a failure either — it
    prints the deliveries that do work right now.
    """
    miss = missing_for(mode)
    if not miss:
        return True
    pkgs = sorted({pkg for _, pkg in miss})
    names = ' and '.join(c for c, _ in miss)
    verb = 'is' if len(miss) == 1 else 'are'
    say()
    warn(f'{C.b}{mode}{C.r} needs {C.c}{names}{C.r}, which {verb} not installed.')
    say(f'{C.d}    The prank itself is already built — this is only how it gets sent.{C.r}')
    say()
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        say(f'    {C.c}sudo pacman -S --needed {" ".join(pkgs)}{C.r}')
        return False
    if ask(f'install {" ".join(pkgs)} now? [Y/n]', 'Y').strip().lower() not in ('y', 'yes'):
        others = [m for m in DELIVERY if m != mode and ready(m)]
        say()
        say(f'{C.d}    No problem. These work right now with nothing to install:{C.r}')
        for m in others:
            say(f'      {C.c}-H {m}{C.r}  {C.d}{DELIVERY[m]["label"]}{C.r}')
        say()
        return False
    say()
    subprocess.run(['sudo', 'pacman', '-S', '--needed'] + pkgs)
    say()
    if missing_for(mode):
        warn(f'{names} still is not there — nothing was sent.')
        return False
    ok(f'{names} installed')
    return True

# ───────────────────────────────────────────────────────────────── cli ────

def banner():
    say()
    say(f'  {C.g}{C.b}biteprank{C.r}  {C.d}·  the prank you send, not the prank you run{C.r}')
    say()


def print_catalog(full=False):
    banner()
    width = max(len(k) for k in SCENES)
    for k, v in SCENES.items():
        tag = f'{C.e}  · spicy{C.r}' if v['spicy'] else ''
        say(f'  {C.c}{k.ljust(width)}{C.r}  {v["desc"]}{tag}')
        if full:
            for line in textwrap.wrap(v['about'], 74):
                say(f'  {" " * width}  {C.d}{line}{C.r}')
            say()
    if not full:
        say()
        say(f'{C.d}  biteprank list --full   for what each one actually does{C.r}')
    say()
    say(f'  {C.y}what the link looks like when they open it{C.r}')
    for k, v in BAITS.items():
        mark = f'{C.g}  ←{C.r}' if k == DEF_BAIT else ''
        say(f'  {C.c}{k.ljust(width)}{C.r}  {v["desc"]}{mark}')
    say()
    say(f'  {C.y}how you send it{C.r}')
    for k, v in DELIVERY.items():
        miss = missing_for(k)
        if miss:
            tag = f'{C.y}  ✗ needs {", ".join(c for c, _ in miss)}{C.r}'
        else:
            tag = f'{C.g}  ✓{C.r}'
        mark = f'{C.g} ←{C.r}' if k == DEF_HOST else ''
        say(f'  {C.c}{k.ljust(width)}{C.r}  {v["label"]}{tag}{mark}')
    say()
    say(f'{C.d}  Anything missing gets offered to you when you pick it — nothing{C.r}')
    say(f'{C.d}  has to be installed before you can look around.{C.r}')
    say()


def about():
    banner()
    body = """
    biteprank makes one self-contained web page and hands you a way to get it
    to someone. Everything happens in their browser tab: it cannot touch their
    files, install anything, or persist past the tab closing. What it can do is
    go fullscreen, make noise, and read back a handful of things about them that
    are genuinely true — the city their IP resolves to, their carrier, their
    browser and OS, their screen, their timezone, their exact battery percentage.

    That honesty is the whole mechanism. Once a page tells you your real battery
    level, the fake 4.2 GB upload underneath it stops looking fake.

    Nobody clicks a bare link and nobody opens a stray file, so the page opens
    as something ordinary first: a message with a blurred video in it, a photo
    waiting to be revealed, a shared folder. The scene fires out of whatever
    they press. That framing is not just dressing — a browser refuses fullscreen
    and refuses to make a sound until the visitor has deliberately touched the
    page, so the bait is what makes the rest work at all.

    Nothing is collected. The geo lookup happens in their tab and the answer
    never leaves it. The one thing that does travel is a single word — opened,
    started, revealed — sent back to the little server in this terminal so you
    can watch it land; it holds no data beyond the request the server already
    saw, it is never written down, and it dies with the link. The reveal tells
    them that happened.

    No scene and no bait ever asks for a password, a login or a payment, and
    none of them imitate a real company. ESC ends any of them instantly, and
    every single one resolves to the same reveal: a big GOTCHA and a plain
    sentence saying nothing happened and nothing was taken.

    Three scenes are marked spicy — format, ransom and webcam read as the real
    thing to people who have actually been hacked before. Aim carefully.
    """
    for para in body.strip().split('\n\n'):
        for line in textwrap.wrap(' '.join(para.split()), 74):
            say(f'  {line}')
        say()
    say(f'  {C.d}forged pages land in {OUTDIR}{C.r}')
    say(f'  {C.d}history: {LOG}{C.r}')
    say()


def preview():
    """What the hub shows in its browser — a static taste, no side effects."""
    banner()
    say(f'  {C.d}One page. Fifteen scenes. Send it, do not run it.{C.r}')
    say()
    demo = [
        ('public address',   '81.•••.•••.42'),
        ('approx. location', 'their actual city'),
        ('network',          'their actual carrier'),
        ('battery',          'their actual %'),
    ]
    for k, v in demo:
        say(f'  {C.d}{k.ljust(18)}{C.r}{C.c}{v}{C.r}')
    say()
    say(f'  {C.g}…then it starts making things up, and they believe those too.{C.r}')
    say()
    keys = ', '.join(list(SCENES)[:8])
    for line in textwrap.wrap(keys + ', …', 70):
        say(f'  {C.d}{line}{C.r}')
    say()
    say(f'  {C.y}the link opens as{C.r} {C.d}a video · a photo · a shared folder{C.r}')
    say(f'  {C.y}you send it by  {C.r} {C.d}public tunnel · your Wi-Fi · GitHub Pages{C.r}')
    say()
    say(f'  {C.y}ESC always ends it. Every scene reveals. Nothing is collected.{C.r}')
    say()


def _getkey():
    """One keypress, with the three-byte arrow sequences folded into names.

    Reads the file descriptor directly rather than sys.stdin: the text wrapper
    buffers, so in raw mode a read(1) can sit waiting for bytes that only arrive
    with the NEXT keypress — which reads as arrow keys simply not working.
    """
    fd = sys.stdin.fileno()
    ch = os.read(fd, 1)
    if ch == b'\x1b':
        import select as _sel
        if not _sel.select([fd], [], [], 0.06)[0]:
            return 'ESC'
        if os.read(fd, 1) != b'[':
            return 'ESC'
        return {b'A': 'UP', b'B': 'DOWN', b'C': 'RIGHT',
                b'D': 'LEFT'}.get(os.read(fd, 1), '?')
    if ch in (b'\r', b'\n'):
        return 'ENTER'
    if ch == b'\x03':
        raise KeyboardInterrupt
    return ch.decode('utf-8', 'replace')


def pick(title, rows, default=0):
    """An arrow-key list, because typing the answer to a menu is not a menu.

    rows are (key, label, tag). Redraws in place by walking the cursor back up,
    so the list never scrolls away. Falls back to the default when there is no
    terminal to drive — a preview pane or a pipe must never block on a keypress.
    """
    n = len(rows)
    idx = max(0, min(default, n - 1))
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return rows[idx][0]
    width = max(len(r[0]) for r in rows)
    say()
    say(f'  {C.y}{title}{C.r}   {C.d}↑↓ move · Enter pick · 1-{n} jump{C.r}')
    say()
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    first = True
    try:
        tty.setraw(fd)
        sys.stdout.write('\x1b[?25l')
        while True:
            if not first:
                sys.stdout.write(f'\x1b[{n}A')
            first = False
            for i, (k, label, tag) in enumerate(rows):
                on = i == idx
                mark = f'{C.g}▸{C.r}' if on else ' '
                name = k.ljust(width)
                body = f'{name}  {label}' if on else f'{C.d}{name}  {label}{C.r}'
                colour = f'{C.b}{C.c}' if on else C.c
                sys.stdout.write(f'\r\x1b[K  {mark} {colour}{body}{C.r}{tag}\r\n')
            sys.stdout.flush()
            k = _getkey()
            if k == 'UP':
                idx = (idx - 1) % n
            elif k == 'DOWN':
                idx = (idx + 1) % n
            elif k == 'ENTER':
                return rows[idx][0]
            elif k in ('ESC', 'q'):
                raise KeyboardInterrupt
            elif k.isdigit() and 1 <= int(k) <= n:
                idx = int(k) - 1
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write('\x1b[?25h')
        sys.stdout.flush()


def ask(prompt, default=''):
    try:
        val = input(f'  {C.g}›{C.r} {prompt}'
                    + (f' {C.d}[{default}]{C.r}' if default else '') + ' ').strip()
    except (EOFError, KeyboardInterrupt):
        say()
        sys.exit(0)
    return val or default


def choose_interactive():
    banner()
    scene = pick('which scene?',
                 [(k, v['desc'], f'{C.e}  · spicy{C.r}' if v['spicy'] else '')
                  for k, v in SCENES.items()])
    say()
    target = ask("their name? (goes in the page, blank to skip)", DEF_NAME)
    gotcha = ask('a line for the reveal? (blank to skip)')

    bait = pick('what the link opens as',
                [(k, v['desc'], '') for k, v in BAITS.items()],
                default=list(BAITS).index(DEF_BAIT) if DEF_BAIT in BAITS else 0)

    rows = []
    for k, v in DELIVERY.items():
        miss = missing_for(k)
        tag = (f'{C.y}  ✗ needs {", ".join(c for c, _ in miss)}{C.r}' if miss
               else f'{C.g}  ✓{C.r}')
        rows.append((k, v['label'], tag))
    host = pick('how it gets to them', rows,
                default=list(DELIVERY).index(DEF_HOST) if DEF_HOST in DELIVERY else 0)
    return scene, bait, target, gotcha, host


def forge(key, bait, target, gotcha, host):
    if key not in SCENES:
        die(f'no scene called {key!r} — try biteprank list')
    if bait not in BAITS:
        die(f'no bait called {bait!r} — one of: {", ".join(BAITS)}')
    if host not in DELIVERY:
        die(f'no delivery called {host!r} — one of: {", ".join(DELIVERY)}')

    banner()
    sc = SCENES[key]
    say(f'  scene     {C.c}{key}{C.r}  {C.d}{sc["desc"]}{C.r}')
    say(f'  bait      {C.c}{bait}{C.r}  {C.d}{BAITS[bait]["label"]}{C.r}')
    if target:
        say(f'  for       {C.c}{target}{C.r}')
    if sc['spicy']:
        warn('this one is spicy — it reads as genuinely real to some people')

    # Ask about tools before building anything, so a missing package never
    # arrives as a wall of dead output after the work is already done.
    if not ensure(host):
        sys.exit(1)

    live = DELIVERY[host]['live']
    page = build_page(key, bait, target, gotcha, report=live)
    say(f'  size      {C.d}{len(page.encode()) / 1024:.1f} KB, self-contained{C.r}')
    say()
    link = DELIVERY[host]['fn'](page, key, target)
    _log(key, target, host, link)
    if live:
        say(f'{C.d}  watching — every stage they reach shows up here:{C.r}')
        say()
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            say()
            ok('link is down. nobody can open it now.')
    return link


HELP = f"""
  {C.g}{C.b}biteprank{C.r}  {C.d}· the prank you send, not the prank you run{C.r}

  {C.y}usage{C.r}
    biteprank                       pick a scene and a delivery, step by step
    biteprank <scene>               forge it with your default delivery
    biteprank make [options]        forge it with everything spelled out
    biteprank list [--full]         every scene, and what it actually does
    biteprank about                 how it works, and what it will not do

  {C.y}options for make{C.r}
    -s, --scene <name>              which scene           {C.d}(default: asked){C.r}
    -n, --name <them>               their name, used in the page
    -m, --msg <line>                a line shown in the reveal
    -b, --bait <what>               {', '.join(BAITS)}   {C.d}(default: {DEF_BAIT}){C.r}
    -H, --host <how>                {', '.join(DELIVERY)}   {C.d}(default: {DEF_HOST}){C.r}
    -o, --out <dir>                 where files land      {C.d}(default: {OUTDIR}){C.r}

  {C.y}examples{C.r}
    biteprank trace
    biteprank make -s ransom -n Yuval -b video -H tunnel
    biteprank make -s bitten -m "happy birthday idiot" -H github

  {C.y}how it lands{C.r}
    The link opens as something ordinary — a video, a photo, a shared folder.
    The scene only fires once they press it, which is also the only moment a
    browser will allow fullscreen and sound. Then you watch each stage they
    reach appear in this terminal, live.

  {C.d}ESC ends any scene. Every scene reveals itself. Nothing is collected.{C.r}
"""


def cmd_make(argv):
    key = target = gotcha = None
    bait = DEF_BAIT
    host = DEF_HOST
    global OUTDIR
    i = 0
    while i < len(argv):
        a = argv[i]
        nxt = argv[i + 1] if i + 1 < len(argv) else None
        if a in ('-s', '--scene'):
            key = nxt; i += 2
        elif a in ('-n', '--name'):
            target = nxt; i += 2
        elif a in ('-m', '--msg', '--message'):
            gotcha = nxt; i += 2
        elif a in ('-b', '--bait'):
            bait = nxt; i += 2
        elif a in ('-H', '--host'):
            host = nxt; i += 2
        elif a in ('-o', '--out'):
            OUTDIR = Path(os.path.expanduser(nxt or '.')); i += 2
        elif a in ('-h', '--help'):
            say(HELP); return
        elif not a.startswith('-') and key is None:
            key = a; i += 1
        else:
            die(f'do not know the option {a!r} — try biteprank --help')
    if key is None:
        key, bait, target, gotcha, host = choose_interactive()
    forge(key, bait, target or DEF_NAME, gotcha or '', host)


def main():
    argv = sys.argv[1:]
    if not argv:
        forge(*choose_interactive())
        return
    cmd = argv[0]
    if cmd == '--preview':
        preview()
    elif cmd in ('-h', '--help', 'help'):
        say(HELP)
    elif cmd in ('list', 'ls', 'scenes'):
        print_catalog(full=any(a in ('--full', '-f') for a in argv[1:]))
    elif cmd in ('about', 'info'):
        about()
    elif cmd == 'make':
        cmd_make(argv[1:])
    elif cmd in SCENES:
        cmd_make(argv)
    else:
        die(f'no scene or command called {cmd!r} — try biteprank list')


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        say()
        sys.exit(0)
